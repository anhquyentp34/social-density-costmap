<?xml version="1.0"?>
<launch>
    <!-- ZED Body Tracking Node -->
    <node pkg="zed_sdk_bridge" type="zed_body_imu_node" name="zed_body_imu_node" output="screen">
        <!-- Camera frame ID -->
        <param name="camera_frame_id" value="zed2i_camera_center" />
        
        <!-- Detection model: HUMAN_BODY_FAST, HUMAN_BODY_ACCURATE, or HUMAN_BODY_MEDIUM -->
        <param name="detection_model" value="HUMAN_BODY_FAST" />
        
        <!-- Enable tracking across frames -->
        <param name="enable_tracking" value="true" />
        
        <!-- Enable body fitting (smooth skeleton movements) -->
        <param name="enable_body_fitting" value="false" />
        
        <!-- Enable segmentation mask -->
        <param name="enable_segmentation" value="false" />
        
        <!-- Body format: 18 or 34 keypoints -->
        <param name="body_format" value="34" />
        
        <!-- Detection confidence threshold (0-100) -->
        <param name="detection_confidence_threshold" value="40.0" />
        
        <!-- Skeleton smoothing (0.0-1.0) -->
        <param name="skeleton_smoothing" value="0.7" />
        
        <!-- Camera resolution: 0=AUTO, 1=HD2K, 2=HD1080, 3=HD720, 4=SVGA, 5=VGA -->
        <param name="camera_resolution" value="2" />
        
        <!-- Depth mode: 0=PERFORMANCE, 1=QUALITY, 2=ULTRA, 3=NEURAL -->
        <param name="depth_mode" value="3" />
    </node>
    
    <!-- Skeleton Visualizer Node -->
    <node pkg="zed_sdk_bridge" type="skeleton_visualizer" name="skeleton_visualizer" output="screen">
        <!-- Subscribe topics -->
        <remap from="bodies" to="/bodies" />
        <remap from="image_raw" to="/image_raw" />
        
        <!-- Publish topics -->
        <remap from="image_skeleton" to="/image_skeleton" />
        <remap from="skeleton_markers" to="/skeleton_markers" />
        
        <!-- Parameters -->
        <param name="show_on_image" value="true" />
        <param name="publish_markers" value="true" />
        <param name="joint_radius" value="3.0" />
        <param name="link_width" value="2.0" />
        <param name="camera_frame_id" value="zed2i_camera_center" />
    </node>
    
    <!-- Proxemic PointCloud Node -->
    <node pkg="zed_sdk_bridge" type="proxemic_pointcloud_node" name="proxemic_pointcloud_node" output="screen">
        <!-- Subscribe topic -->
        <remap from="bodies" to="/bodies" />
        
        <!-- Publish topic -->
        <remap from="proxemic_cloud" to="/proxemic_cloud" />
        
        <!-- Parameters -->
        <param name="sigma_body" value="0.5" />
        <param name="sigma_arm" value="0.3" />
        <param name="voxel_resolution" value="0.05" />
        <param name="volume_size" value="1.0" />
        <param name="intensity_threshold" value="0.1" />
        <param name="enable_arm_proxemic" value="true" />
        <param name="frame_id" value="" />
    </node>
</launch>

