<?xml version="1.0" encoding="UTF-8"?>
<!--
  YOLO /objects + /depth → mark/clear PointCloud2 (hình dạng vật từ depth trong bbox).
-->
<launch>
  <arg name="objects_topic" default="/objects"/>
  <arg name="depth_topic" default="/depth"/>
  <arg name="camera_info_topic" default="/camera_info"/>
  <arg name="cloud_topic" default="/yolo_obstacle_cloud"/>
  <arg name="clear_topic" default="/yolo_obstacle_clear"/>
  <arg name="use_depth" default="true"/>
  <arg name="depth_stride" default="4"/>
  <arg name="depth_band" default="0.40"/>
  <arg name="grid_step" default="0.05"/>
  <arg name="min_confidence" default="25.0"/>
  <!-- Giữ track lâu hơn chu kỳ YOLO (~2–3 Hz) để tránh nhấp nháy/dao động trên costmap -->
  <arg name="hold_sec" default="1.5"/>
  <arg name="stale_sec" default="2.5"/>
  <arg name="republish_hz" default="10.0"/>
  <arg name="fixed_frame" default="odom"/>

  <node name="yolo_objects_to_obstacle_cloud" pkg="ultralytics_ros"
        type="yolo_objects_to_obstacle_cloud.py" output="screen">
    <param name="objects_topic" value="$(arg objects_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="cloud_topic" value="$(arg cloud_topic)"/>
    <param name="clear_topic" value="$(arg clear_topic)"/>
    <param name="use_depth" value="$(arg use_depth)"/>
    <param name="depth_stride" value="$(arg depth_stride)"/>
    <param name="depth_band" value="$(arg depth_band)"/>
    <param name="grid_step" value="$(arg grid_step)"/>
    <param name="min_confidence" value="$(arg min_confidence)"/>
    <param name="hold_sec" value="$(arg hold_sec)"/>
    <param name="stale_sec" value="$(arg stale_sec)"/>
    <param name="republish_hz" value="$(arg republish_hz)"/>
    <param name="fixed_frame" value="$(arg fixed_frame)"/>
  </node>
</launch>
