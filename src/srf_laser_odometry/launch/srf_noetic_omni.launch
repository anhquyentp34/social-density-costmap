<launch>
  <arg name="scan_topic" default="/scan"/>
  <arg name="odom_topic" default="/odom_srf"/>

  <arg name="base_frame" default="base_footprint"/>
  <arg name="odom_frame" default="odom"/>

  <arg name="publish_tf" default="false"/>
  <arg name="operation_mode" default="HYBRID"/>

  <arg name="laser_decimation" default="1"/>
  <arg name="laser_min_range" default="0.10"/>
  <arg name="laser_max_range" default="-1.0"/>

  <node pkg="srf_laser_odometry"
        type="srf_laser_odometry_node"
        name="srf_laser_odometry"
        output="screen"
        respawn="false">

    <param name="laser_scan_topic" value="$(arg scan_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>

    <param name="base_frame_id" value="$(arg base_frame)"/>
    <param name="odom_frame_id" value="$(arg odom_frame)"/>

    <param name="publish_tf" value="$(arg publish_tf)"/>
    <param name="operation_mode" value="$(arg operation_mode)"/>

    <param name="laser_decimation" value="$(arg laser_decimation)"/>
    <param name="laser_min_range" value="$(arg laser_min_range)"/>
    <param name="laser_max_range" value="$(arg laser_max_range)"/>

    <param name="init_pose_from_topic" value=""/>
  </node>
</launch>
