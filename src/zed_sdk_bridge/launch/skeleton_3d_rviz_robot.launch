<?xml version="1.0"?>
<!--
  Launch file để hiển thị Skeleton 3D trong RViz với Transform từ URDF Robot
  Dựa trên vị trí camera trong ssmr_description.urdf
  
  Cấu trúc transform từ URDF (ROS convention: X=forward, Y=left, Z=up):
  base_link → base_sensor_link: xyz="0.0935 0 0.11443"
  base_sensor_link → zed2i_camera_link: xyz="0.053 0.0017726 0.295"
  
  Tổng hợp từ base_link đến zed2i_camera_link:
  - X: 0.1465 m (14.65 cm về phía trước - forward)
  - Y: 0.0017726 m (0.18 cm sang phải - gần như 0, trong ROS Y là left nên giá trị dương là right)
  - Z: 0.40943 m (40.94 cm lên trên - up)
  
  LƯU Ý: ZED Body Tracking đã được cấu hình để sử dụng RIGHT_HANDED_Z_UP_X_FWD
  (đồng nhất với ROS convention) để skeleton hiển thị đúng trong RViz.
  
  Sử dụng:
    roslaunch zed_sdk_bridge skeleton_3d_rviz_robot.launch
-->
<launch>
    <!-- Arguments -->
    <arg name="body_format" default="34" doc="Body format: 18 or 34 keypoints" />
    <arg name="detection_model" default="HUMAN_BODY_FAST" doc="Detection model" />
    <arg name="use_rviz" default="true" doc="Launch RViz" />
    <arg name="show_image" default="false" doc="Open image_view window to show 2D image with skeleton overlay. Topic /image_skeleton is always published (can view in RViz or rqt_image_view)" />
    
    <!-- Costmap parameters -->
    <arg name="selected_bones" default="5,6" doc="Selected bones for costmap (format: 'idx1,idx2' or 'idx1,idx2;idx3,idx4'). Default: '5,6' (LEFT_SHOULDER -> LEFT_ELBOW)" />
    <arg name="voxel_resolution" default="0.03" doc="Voxel resolution in meters. Default 3cm" />
    <arg name="inflation_radius" default="0.3" doc="Inflation radius in meters. Default 30cm" />
    
    <!-- Transform parameters từ URDF -->
    <arg name="base_frame" default="base_link" doc="Base frame của robot" />
    <arg name="camera_frame" default="zed2i_camera_center" doc="Camera frame từ ZED body tracking" />
    
    <!-- Vị trí camera từ URDF (tính từ base_link) -->
    <!-- base_link → base_sensor_link: (0.0935, 0, 0.11443) -->
    <!-- base_sensor_link → zed2i_camera_link: (0.053, 0.0017726, 0.295) -->
    <!-- Tổng: (0.1465, 0.0017726, 0.40943) -->
    <arg name="camera_x" default="0.1465" doc="Camera X position từ base_link (meters)" />
    <arg name="camera_y" default="0.0017726" doc="Camera Y position từ base_link (meters)" />
    <arg name="camera_z" default="0.40943" doc="Camera Z position (height) từ base_link (meters)" />
    
    <!-- Hướng camera (radians) -->
    <!-- Camera nhìn thẳng về phía trước (theo trục X của robot) -->
    <arg name="camera_roll" default="0.0" doc="Camera roll (radians)" />
    <arg name="camera_pitch" default="0.0" doc="Camera pitch - có thể điều chỉnh để nhìn hơi xuống (radians)" />
    <arg name="camera_yaw" default="0.0" doc="Camera yaw (radians)" />
    
    <!-- Static Transform từ base_link đến camera frame -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_camera_tf" 
          args="$(arg camera_x) $(arg camera_y) $(arg camera_z) 
                $(arg camera_roll) $(arg camera_pitch) $(arg camera_yaw) 
                $(arg base_frame) $(arg camera_frame)" />
    
    <!-- Include launch file gốc (tắt RViz để tránh conflict) -->
    <include file="$(find zed_sdk_bridge)/launch/skeleton_3d_rviz.launch">
        <arg name="body_format" value="$(arg body_format)" />
        <arg name="detection_model" value="$(arg detection_model)" />
        <arg name="use_rviz" value="false" />
        <arg name="show_image" value="$(arg show_image)" />
    </include>
    
    <!-- Skeleton Costmap 3D Node -->
    <include file="$(find zed_sdk_bridge)/launch/skeleton_costmap_3d.launch">
        <arg name="voxel_resolution" value="$(arg voxel_resolution)" />
        <arg name="inflation_radius" value="$(arg inflation_radius)" />
        <arg name="selected_bones" value="$(arg selected_bones)" />
        <arg name="joint_radius" value="0.02" doc="2cm - bán kính joint" />
        <arg name="bone_radius" value="0.015" doc="1.5cm - bán kính bone" />
        <arg name="frame_id" value="zed2i_camera_center" />
        <arg name="launch_body_tracking" value="false" doc="Body tracking đã được launch trong skeleton_3d_rviz.launch" />
    </include>
    
    <!-- RViz với config cho robot (Fixed Frame = base_link) -->
    <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz_skeleton_3d_robot" 
          args="-d $(find zed_sdk_bridge)/rviz/skeleton_robot.rviz" output="screen" />
</launch>

