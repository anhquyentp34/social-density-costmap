<?xml version="1.0" encoding="UTF-8"?>
<!--
  Track A C1 — Semantic segmentation (DeepLabV3 VOC) → costmap cloud.
  Giữ topic /yolo_obstacle_cloud + /yolo_obstacle_clear để khớp yolo_obstacles_layer.
-->
<launch>
  <arg name="image_topic" default="/image_raw"/>
  <arg name="depth_topic" default="/depth"/>
  <arg name="camera_info_topic" default="/camera_info"/>
  <arg name="labels_topic" default="/semantic/labels"/>
  <arg name="color_topic" default="/semantic/color"/>
  <arg name="cloud_topic" default="/yolo_obstacle_cloud"/>
  <arg name="clear_topic" default="/yolo_obstacle_clear"/>
  <arg name="device" default="cuda:0"/>
  <arg name="process_hz" default="3.0"/>
  <arg name="imgsz" default="520"/>
  <arg name="depth_stride" default="4"/>
  <arg name="hold_sec" default="1.5"/>
  <arg name="stale_sec" default="2.5"/>
  <arg name="republish_hz" default="10.0"/>
  <arg name="fixed_frame" default="odom"/>
  <arg name="classes_yaml"
       default="$(find ultralytics_ros)/config/A-yolo-costmap/semantic_classes.yaml"/>
  <arg name="base_image_topic" default="/image_skeleton"/>
  <arg name="overlay_topic" default="/image_skeleton_semantic"/>
  <arg name="overlay_alpha" default="0.45"/>

  <node name="semantic_seg_node" pkg="ultralytics_ros"
        type="semantic_seg_node.py" output="screen">
    <param name="input_topic" value="$(arg image_topic)"/>
    <param name="labels_topic" value="$(arg labels_topic)"/>
    <param name="color_topic" value="$(arg color_topic)"/>
    <param name="device" value="$(arg device)"/>
    <param name="process_hz" value="$(arg process_hz)"/>
    <param name="imgsz" value="$(arg imgsz)"/>
    <param name="publish_color" value="true"/>
  </node>

  <node name="semantic_zed_overlay" pkg="ultralytics_ros"
        type="semantic_zed_overlay.py" output="screen">
    <param name="base_image_topic" value="$(arg base_image_topic)"/>
    <param name="labels_topic" value="$(arg labels_topic)"/>
    <param name="output_topic" value="$(arg overlay_topic)"/>
    <param name="alpha" value="$(arg overlay_alpha)"/>
  </node>

  <node name="semantic_to_obstacle_cloud" pkg="ultralytics_ros"
        type="semantic_to_obstacle_cloud.py" output="screen">
    <param name="labels_topic" value="$(arg labels_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="cloud_topic" value="$(arg cloud_topic)"/>
    <param name="clear_topic" value="$(arg clear_topic)"/>
    <param name="classes_yaml" value="$(arg classes_yaml)"/>
    <param name="depth_stride" value="$(arg depth_stride)"/>
    <param name="hold_sec" value="$(arg hold_sec)"/>
    <param name="stale_sec" value="$(arg stale_sec)"/>
    <param name="republish_hz" value="$(arg republish_hz)"/>
    <param name="fixed_frame" value="$(arg fixed_frame)"/>
  </node>
</launch>
