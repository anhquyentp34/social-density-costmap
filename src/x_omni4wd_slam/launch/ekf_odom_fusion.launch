<?xml version="1.0"?>
<launch>
  <!--
    Định vị tương đối — fusion 2 nguồn bằng robot_localization EKF:
      wheel_odometry  -> /odom_wheel  (twist vx, vy, vyaw)
      RF2O laser odom -> /odom_rf2o   (pose x, y, yaw)
      EKF             -> /odometry/filtered (+ relay /odom) + TF odom->base_footprint

    Dùng cho sim (joint_states Gazebo) hoặc robot thật (encoder /wheel_encoder_joint_states).

    Ví dụ:
      roslaunch x_omni4wd_slam ekf_odom_fusion.launch
      roslaunch x_omni4wd_slam ekf_odom_fusion.launch joint_states_topic:=/wheel_encoder_joint_states
  -->

  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="wheel_odom_topic" default="/odom_wheel"/>
  <arg name="rf2o_odom_topic" default="/odom_rf2o"/>
  <arg name="ekf_filtered_topic" default="/odometry/filtered"/>

  <arg name="odom_frame" default="odom"/>
  <arg name="base_frame" default="base_footprint"/>
  <arg name="map_frame" default="map"/>

  <arg name="joint_states_topic" default="/x_omni4wd/joint_states"
       doc="Sim: /x_omni4wd/joint_states | Robot: /wheel_encoder_joint_states"/>
  <arg name="R" default="0.2505"/>
  <arg name="wheel_radius" default="0.0635"/>
  <arg name="wheel_odom_rate" default="50.0"/>
  <arg name="rf2o_freq" default="10.0"/>
  <arg name="ekf_config" default="$(find x_omni4wd_slam)/config/ekf_x_omni4wd.yaml"/>

  <arg name="use_wheel_odom" default="true"/>
  <arg name="use_rf2o" default="true"/>
  <arg name="relay_filtered_to_odom" default="true"/>

  <!-- Wheel odometry (không publish TF) -->
  <node if="$(arg use_wheel_odom)" name="wheel_odometry" pkg="x_omni4wd_slam" type="wheel_odometry_node.py" output="screen">
    <rosparam command="load" file="$(find x_omni4wd_slam)/config/wheel_odom_x_omni4wd.yaml"/>
    <param name="odom_topic" value="$(arg wheel_odom_topic)"/>
    <param name="base_frame_id" value="$(arg base_frame)"/>
    <param name="odom_frame_id" value="$(arg odom_frame)"/>
    <param name="publish_tf" value="false"/>
    <param name="wheel_radius" value="$(arg wheel_radius)"/>
    <param name="R" value="$(arg R)"/>
    <param name="rate" value="$(arg wheel_odom_rate)"/>
    <param name="joint_states_topic" value="$(arg joint_states_topic)"/>
  </node>

  <!-- RF2O laser odometry (không publish TF) -->
  <node if="$(arg use_rf2o)" name="rf2o_laser_odometry" pkg="rf2o_laser_odometry" type="rf2o_laser_odometry_node" output="screen">
    <rosparam command="load" file="$(find x_omni4wd_slam)/config/rf2o_x_omni4wd.yaml"/>
    <param name="laser_scan_topic" value="$(arg scan_topic)"/>
    <param name="odom_topic" value="$(arg rf2o_odom_topic)"/>
    <param name="publish_tf" value="false"/>
    <param name="base_frame_id" value="$(arg base_frame)"/>
    <param name="odom_frame_id" value="$(arg odom_frame)"/>
    <param name="freq" value="$(arg rf2o_freq)"/>
    <param name="laser_fps" value="$(arg rf2o_freq)"/>
  </node>

  <!-- EKF -->
  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization" clear_params="true" output="screen">
    <rosparam command="load" file="$(arg ekf_config)"/>
    <remap from="odom0" to="$(arg wheel_odom_topic)"/>
    <remap from="odom1" to="$(arg rf2o_odom_topic)"/>
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>
    <param name="base_link_frame" value="$(arg base_frame)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="world_frame" value="$(arg odom_frame)"/>
  </node>

  <node if="$(arg relay_filtered_to_odom)" pkg="topic_tools" type="relay" name="ekf_odom_relay"
        args="$(arg ekf_filtered_topic) $(arg odom_topic)"/>
</launch>
