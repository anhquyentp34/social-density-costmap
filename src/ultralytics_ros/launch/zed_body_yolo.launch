<?xml version="1.0" encoding="UTF-8"?>
<!--
  YOLO (Ultralytics, ~80 lớp COCO) trên /image_raw từ zed_sdk_bridge
  + bridge depth → /objects (thay ZED SDK Object Detection).

  Cần zed_sdk_bridge đang chạy (publish /image_raw, /depth, /camera_info).
  Tắt ZED OD: enable_object_detection:=false (mặc định mới).
  Xem ảnh trong RViz; debug:=true mới mở cửa sổ image riêng.
-->
<launch>
  <arg name="debug" default="false"/>
  <arg name="use_rviz" default="false"/>
  <arg name="yolo_model" default="yolov8n.pt"/>
  <arg name="conf_thres" default="0.25"/>
  <arg name="iou_thres" default="0.45"/>
  <arg name="max_det" default="300"/>
  <arg name="classes" default=""/>
  <arg name="tracker" default="bytetrack.yaml"/>
  <arg name="device" default=""/>
  <arg name="result_conf" default="true"/>
  <arg name="result_line_width" default="2"/>
  <arg name="result_font_size" default="1"/>
  <arg name="result_font" default="Arial.ttf"/>
  <arg name="result_labels" default="true"/>
  <arg name="result_boxes" default="true"/>

  <arg name="input_topic" default="/image_raw"/>
  <arg name="result_topic" default="/yolo_result"/>
  <arg name="result_image_topic" default="/yolo_result_image"/>
  <arg name="depth_topic" default="/depth"/>
  <arg name="camera_info_topic" default="/camera_info"/>
  <arg name="objects_topic" default="/objects"/>
  <arg name="filter_person" default="true"/>
  <arg name="bridge_min_confidence" default="0.25"/>
  <arg name="process_hz" default="5.0"/>
  <arg name="imgsz" default="480"/>
  <arg name="publish_result_image" default="false"/>
  <arg name="launch_delay" default="0.0"/>

  <node name="yolo_tracker_node" pkg="ultralytics_ros" type="tracker_node.py" output="screen"
        launch-prefix="bash -c 'sleep $(arg launch_delay); exec $0 $@' --">
    <param name="yolo_model" value="$(arg yolo_model)"/>
    <param name="input_topic" value="$(arg input_topic)"/>
    <param name="result_topic" value="$(arg result_topic)"/>
    <param name="result_image_topic" value="$(arg result_image_topic)"/>
    <param name="conf_thres" value="$(arg conf_thres)"/>
    <param name="iou_thres" value="$(arg iou_thres)"/>
    <param name="max_det" value="$(arg max_det)"/>
    <param name="tracker" value="$(arg tracker)"/>
    <param name="result_conf" value="$(arg result_conf)"/>
    <param name="result_line_width" value="$(arg result_line_width)"/>
    <param name="result_font_size" value="$(arg result_font_size)"/>
    <param name="result_font" value="$(arg result_font)"/>
    <param name="result_labels" value="$(arg result_labels)"/>
    <param name="result_boxes" value="$(arg result_boxes)"/>
    <param name="process_hz" value="$(arg process_hz)"/>
    <param name="imgsz" value="$(arg imgsz)"/>
    <param name="publish_result_image" value="$(arg publish_result_image)"/>
    <rosparam param="classes" subst_value="true">$(arg classes)</rosparam>
    <rosparam param="device" subst_value="true">$(arg device)</rosparam>
  </node>

  <node name="yolo_objects_bridge" pkg="ultralytics_ros" type="yolo_objects_bridge.py" output="screen"
        launch-prefix="bash -c 'sleep $(arg launch_delay); exec $0 $@' --">
    <param name="yolo_topic" value="$(arg result_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="objects_topic" value="$(arg objects_topic)"/>
    <param name="filter_person" value="$(arg filter_person)"/>
    <param name="min_confidence" value="$(arg bridge_min_confidence)"/>
  </node>

  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find ultralytics_ros)/rviz/yolo_2d.rviz" output="screen"/>

  <group if="$(arg debug)">
    <group unless="$(arg use_rviz)">
      <node name="yolo_image_view" pkg="image_view" type="image_view" output="screen">
        <remap from="image" to="$(arg result_image_topic)"/>
      </node>
    </group>
  </group>
</launch>
