<?xml version="1.0"?>
<!--
  ZED 2i cho robot thật — không required (crash ZED không tắt navigation/Arduino).

  zed_wrapper mặc định required="true" -> roslaunch shutdown khi zed_wrapper_node chết (exit -11).
-->
<launch>
  <arg name="camera_name" default="zed2i"/>
  <arg name="node_name" default="zed_node"/>
  <arg name="camera_model" default="zed2i"/>
  <arg name="base_frame" default="camera_link"/>
  <arg name="svo_file" default=""/>
  <arg name="stream" default=""/>
  <arg name="camera_id" default="0"/>
  <arg name="gpu_id" default="-1"/>
  <arg name="zed_respawn" default="true"/>
  <arg name="zed_respawn_delay" default="30.0"/>

  <group ns="$(arg camera_name)">
    <node name="$(arg node_name)" pkg="zed_wrapper" type="zed_wrapper_node"
          output="screen" required="false" respawn="$(arg zed_respawn)" respawn_delay="$(arg zed_respawn_delay)">
      <rosparam file="$(find zed_wrapper)/params/common.yaml" command="load"/>
      <rosparam file="$(find zed_wrapper)/params/$(arg camera_model).yaml" command="load"/>
      <param name="general/camera_name" value="$(arg camera_name)"/>
      <param name="general/base_frame" value="$(arg base_frame)"/>
      <param name="general/camera_model" value="$(arg camera_model)"/>
      <param name="svo_file" value="$(arg svo_file)"/>
      <param name="stream" value="$(arg stream)"/>
      <param name="general/zed_id" value="$(arg camera_id)"/>
      <param name="general/gpu_id" value="$(arg gpu_id)"/>
      <!-- Giảm tải GPU / tránh crash khi chạy đồng thời navigation -->
      <param name="mapping/mapping_enabled" value="false"/>
    </node>
  </group>
</launch>
