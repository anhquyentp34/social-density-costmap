<?xml version="1.0"?>
<launch>
  <arg name="republish_gated_odom" default="true"/>
  <arg name="enable_directional_cov" default="true"/>
  <arg name="enable_soft_vio_gate" default="true"/>
  <arg name="gate_threshold" default="0.35"/>
  <arg name="inflate_gain" default="20.0"/>
  <arg name="along_scale" default="0.55"/>
  <arg name="cross_scale" default="1.80"/>
  <arg name="disagree_sigma_m" default="0.12"/>

  <node pkg="x_omni4wd_slam" type="reliability_node.py" name="reliability_node" output="screen">
    <param name="republish_gated_odom" value="$(arg republish_gated_odom)"/>
    <param name="enable_directional_cov" value="$(arg enable_directional_cov)"/>
    <param name="enable_soft_vio_gate" value="$(arg enable_soft_vio_gate)"/>
    <param name="gate_threshold" value="$(arg gate_threshold)"/>
    <param name="inflate_gain" value="$(arg inflate_gain)"/>
    <param name="along_scale" value="$(arg along_scale)"/>
    <param name="cross_scale" value="$(arg cross_scale)"/>
    <param name="disagree_sigma_m" value="$(arg disagree_sigma_m)"/>
  </node>
</launch>
